# ==============================================================================
# FreelanceHub — Environment Variables Configuration
# Copy this file to `.env` and fill in your connection details.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Development PostgreSQL Connection
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/freelancehub_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Production Managed PostgreSQL (Neon / Supabase / Vercel Postgres)
# ------------------------------------------------------------------------------
# For serverless deployment on Vercel, use a connection-pooled string:
# Neon: postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.us-east-2.aws.neon.tech/[DB]?sslmode=require&pgbouncer=true
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"


